# Stepik Course Archiver - Environment Variables Example
# Copy this file to .env and fill in your values

# Optional: Stepik personal access token
# Get it from https://stepik.org/edit-profile/tokens
STEPIC_TOKEN=

# Optional: OAuth2 application credentials
# Create at https://stepik.org/oauth2/applications/
# Type: confidential, Grant: client-credentials
STEPIC_CLIENT_ID=
STEPIC_CLIENT_SECRET=

# Database URL (SQLite by default)
DATABASE_URL="file:./db/custom.db"
